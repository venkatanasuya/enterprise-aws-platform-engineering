# Keep source files with LF line endings
* text=auto eol=lf

# Terraform
*.tf text eol=lf
*.tfvars text eol=lf
*.hcl text eol=lf

# YAML / JSON / Shell
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Markdown
*.md text eol=lf

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf